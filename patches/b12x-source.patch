+                else:
+                    # FP32 outputs expose those weight ulps; require FP32-level
+                    # agreement rather than bit identity.
+                    torch.testing.assert_close(
+                        actual, expected, rtol=1e-5, atol=1e-6
+                    )
+                # The 16-bit reference path (FP32 accumulate of BF16-rounded
+                # partials) must not be closer to the FP64 truth than this kernel.
+                if out_dtype == torch.bfloat16:
+                    truth = _fp32_reference(stacked, stacked_lse, rank, torch.float64)
+                    bf16_path = lse_reduce_scatter_reference(
+                        stacked.to(torch.bfloat16), stacked_lse, rank
+                    )
+                    kernel_err = (actual.double() - truth).abs().mean().item()
+                    bf16_err = (bf16_path.double() - truth).abs().mean().item()
+                    assert kernel_err <= bf16_err * 1.05 + 1e-7, (kernel_err, bf16_err)
+            # Head-major capacity-strided input layout, as produced by the
+            # B12X sparse MLA scratch.
+            storage = torch.empty(TOTAL_HEADS, 16, HEAD_DIM, dtype=torch.float32, device=device)
+            head_major = storage.transpose(0, 1)[:batch]
+            head_major.copy_(partial_output)
+            out = torch.empty(batch, TOTAL_HEADS // world_size, HEAD_DIM, dtype=torch.bfloat16, device=device)
