+        graph_lse = torch.empty(batch, TOTAL_HEADS, dtype=torch.float32, device=device)
+        graph_out = torch.empty(batch, TOTAL_HEADS // world_size, HEAD_DIM, dtype=torch.bfloat16, device=device)
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.stream(stream):
+            initial_output, initial_lse = _rank_inputs(400, rank, batch, torch.float32, device)
+            graph_input.copy_(initial_output)
+            graph_lse.copy_(initial_lse)
+            torch.cuda.synchronize(device)
