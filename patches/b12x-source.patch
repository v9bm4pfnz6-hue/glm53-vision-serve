+def _fp32_reference(
+    partial_outputs: torch.Tensor,
+    partial_lses: torch.Tensor,
+    rank: int,
+    out_dtype: torch.dtype,
+) -> torch.Tensor:
+    """FP32 weights (as the kernel computes them) applied to the stacked FP32
+    partials with FP64 accumulation, rounded once to ``out_dtype``."""
+    world_size, _, total_heads, _ = partial_outputs.shape
+    heads_per_rank = total_heads // world_size
+    head_slice = slice(rank * heads_per_rank, (rank + 1) * heads_per_rank)
+    outputs = partial_outputs[:, :, head_slice, :].double()
+    lses = partial_lses[:, :, head_slice].float()
+    valid = torch.isfinite(lses)
+    sanitized = torch.where(valid, lses, torch.full_like(lses, -torch.inf))
+    max_lse = sanitized.amax(dim=0)
+    max_lse = torch.where(torch.isfinite(max_lse), max_lse, 0.0)
+    weights = torch.exp(sanitized - max_lse.unsqueeze(0))
+    weights = torch.where(valid, weights, torch.zeros_like(weights))
+    inv_sum = 1.0 / weights.sum(dim=0, keepdim=True).clamp_min(1e-10)
+    normalized = (weights * inv_sum).double()
+    outputs = torch.where(valid.unsqueeze(-1), outputs, torch.zeros_like(outputs))
+    return (outputs * normalized.unsqueeze(-1)).sum(dim=0).to(out_dtype)
+
+
+def _check_fp32_partials(
+    rank: int,
+    world_size: int,
+    device: torch.device,
+) -> None:
+    """FP32 partial outputs on a 4-byte channel: eager and graph replay.
+
+    The kernel accumulates in FP64 and rounds once, so against an FP64
+    reference it must be at least as close as an FP32-accumulated BF16 path;
+    the test checks a tight tolerance plus exact agreement on most elements.
+    """
+    pool = PCIeDCPA2APool.from_process_group(
+        process_group=dist.group.WORLD,
+        device=device,
+        max_batch_size=16,
+        total_heads=TOTAL_HEADS,
+        head_dim=HEAD_DIM,
+        query_head_dim=QUERY_HEAD_DIM,
+        max_concurrent_channels=2,
+        output_elem_bytes=4,
+    )
+    try:
+        pool.prepare_channels(("eager:fp32", "graph:fp32"))
+        pool.prepare_graph_lse_reduce_scatter(
+            dtype=torch.float32, out_dtype=torch.bfloat16, channel_id="eager:fp32"
+        )
+        for step, batch in enumerate((1, 2, 4, 8, 16), start=300):
+            partial_output, partial_lse = _rank_inputs(
+                step, rank, batch, torch.float32, device
+            )
+            # A few empty shards (non-finite LSE) must contribute zero weight.
+            if step % 2 == 0:
+                partial_lse[:, rank::world_size] = float("-inf")
+            stacked = torch.stack(
+                [_rank_inputs(step, source, batch, torch.float32, device)[0] for source in range(world_size)]
+            )
+            stacked_lse = torch.stack(
+                [_rank_inputs(step, source, batch, torch.float32, device)[1] for source in range(world_size)]
+            )
+            if step % 2 == 0:
+                for source in range(world_size):
+                    stacked_lse[source][:, source::world_size] = float("-inf")
+            for out_dtype in (torch.bfloat16, torch.float32):
+                out = torch.empty(
+                    batch, TOTAL_HEADS // world_size, HEAD_DIM, dtype=out_dtype, device=device
+                )
+                actual = pool.lse_reduce_scatter(
+                    partial_output, partial_lse, out=out, channel_id="eager:fp32"
+                )
+                torch.cuda.synchronize(device)
+                assert actual is out
+                expected = _fp32_reference(stacked, stacked_lse, rank, out_dtype)
+                if out_dtype == torch.bfloat16:
