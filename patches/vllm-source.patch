@@ -0,0 +1,353 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU tests for the uneven column-parallel GLM low-rank projections."""
+
+import os
+from unittest.mock import patch
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from vllm.model_executor.layers.glm_uneven_linear import (
+    GlmUnevenColumnLinear,
+    uneven_row_ranges,
+)
+
+WORLD = 9
+
+
+class _FakeTpGroup:
+    def __init__(self, rank):
+        self.rank_in_group = rank
+        self.world_size = WORLD
+
+
+def _tp_context(rank):
+    # Every TP getter in parallel_state resolves through get_tp_group(); one
+    # patch covers all modules that imported the getters by value.
+    return patch(
+        "vllm.distributed.parallel_state.get_tp_group",
+        return_value=_FakeTpGroup(rank),
+    )
+
+
+def test_row_ranges_cover_original_rows_without_padding():
+    for output_size, block_size in ((2048, 128), (576, 64), (6144, 128), (4096, 128)):
+        ranges = uneven_row_ranges(output_size, block_size, WORLD)
+        assert len(ranges) == WORLD
+        counts = [end - start for start, end in ranges]
+        assert sum(counts) == output_size
+        assert max(counts) - min(counts) <= block_size
+        assert ranges[0][0] == 0
+        for (prev_start, prev_end), (start, end) in zip(ranges, ranges[1:]):
+            assert prev_end == start
+        assert ranges[-1][1] == output_size
+
+
+def test_row_ranges_reject_degenerate_partitions():
+    with pytest.raises(ValueError):
+        uneven_row_ranges(256, 128, WORLD)
+    with pytest.raises(ValueError):
+        uneven_row_ranges(100, 64, WORLD)
+
+
+def test_weight_loader_slices_rows_and_shared_scale_blocks():
+    with _tp_context(1):
+        layer = GlmUnevenColumnLinear(
+            64, 576, block_size=64, params_dtype=torch.float32
+        )
+    full = torch.arange(576 * 64, dtype=torch.float32).reshape(576, 64)
+    layer.weight_loader(layer.weight, full)
+    torch.testing.assert_close(layer.weight, full[64:128])
+    # The 576-row FP8 projection has five 128-row scale blocks; rank 1 shares
+    # scale block 0 with rank 0.
+    scales = torch.arange(5 * 8, dtype=torch.float32).reshape(5, 8)
+    local_scale = torch.nn.Parameter(torch.empty(1, 8))
+    layer.weight_loader(local_scale, scales)
+    torch.testing.assert_close(local_scale, scales[0:1])
+    with pytest.raises(ValueError):
+        layer.weight_loader(local_scale, torch.empty(7, 8))
+
+
+def _forward_all_rangs(input_size, output_size, block_size, dtype):
+    x = torch.randn(3, input_size, dtype=dtype)
+    reference_weight = torch.randn(output_size, input_size, dtype=dtype)
+    locals_ = []
+    for rank in range(WORLD):
+        with _tp_context(rank):
+            layer = GlmUnevenColumnLinear(
+                input_size, output_size, block_size=block_size, params_dtype=dtype
+            )
+            layer.weight_loader(layer.weight, reference_weight)
+            local = layer.quant_method.apply(layer, x, None)
+        locals_.append((layer, local))
+    max_rows = max(local.shape[-1] for _, local in locals_)
+    padded = [F.pad(local, (0, max_rows - local.shape[-1])) for _, local in locals_]
+    gathered = torch.cat(padded, dim=-1)
+    out = gathered.index_select(-1, locals_[0][0].gather_indices)
+    return out, F.linear(x, reference_weight)
+
+
+def test_forward_reconstructs_full_width_output_exactly():
+    for output_size, block_size in ((2048, 128), (576, 64), (6144, 128)):
+        out, reference = _forward_all_rangs(64, output_size, block_size, torch.float64)
+        assert out.shape == (3, output_size)
+        torch.testing.assert_close(out, reference, rtol=0, atol=0)
+
+
+def test_fused_qkv_a_shards_and_reconstructs_exactly():
+    from vllm.model_executor.layers.glm_uneven_linear import GlmUnevenFusedQkvALinear
+
+    dtype = torch.float64
+    q_size, kv_size, k = 2048, 576, 64
+    q_weight = torch.randn(q_size, k, dtype=dtype)
+    kv_weight = torch.randn(kv_size, k, dtype=dtype)
+    x = torch.randn(3, k, dtype=dtype)
+    locals_ = []
+    for rank in range(WORLD):
+        with _tp_context(rank):
+            layer = GlmUnevenFusedQkvALinear(k, [q_size, kv_size], params_dtype=dtype)
+            layer.weight_loader(layer.weight, q_weight, 0)
+            layer.weight_loader(layer.weight, kv_weight, 1)
+            qs, qe = layer.component_ranges[0][rank]
+            ks, ke = layer.component_ranges[1][rank]
+            torch.testing.assert_close(layer.weight[: qe - qs], q_weight[qs:qe])
+            torch.testing.assert_close(
+                layer.weight[qe - qs : qe - qs + (ke - ks)], kv_weight[ks:ke]
+            )
+            local = layer.quant_method.apply(layer, x, None)
+        locals_.append((layer, local))
+    max_rows = max(local.shape[-1] for _, local in locals_)
+    padded = [F.pad(local, (0, max_rows - local.shape[-1])) for _, local in locals_]
+    gathered = torch.cat(padded, dim=-1)
+    out = gathered.index_select(-1, locals_[0][0].gather_indices)
+    reference = F.linear(x, torch.cat([q_weight, kv_weight], dim=0))
+    assert out.shape == (3, q_size + kv_size)
+    torch.testing.assert_close(out, reference, rtol=0, atol=0)
+
+
+def test_fused_qkv_a_scale_loader_uses_component_blocks():
+    from vllm.model_executor.layers.glm_uneven_linear import GlmUnevenFusedQkvALinear
+
+    with _tp_context(1):
+        layer = GlmUnevenFusedQkvALinear(64, [2048, 576], params_dtype=torch.float32)
+    q_scales = torch.arange(16 * 8, dtype=torch.float32).reshape(16, 8)
+    kv_scales = torch.arange(5 * 8, dtype=torch.float32).reshape(5, 8)
+    q_blocks = (layer.local_q + 127) // 128
+    local_scale = torch.nn.Parameter(torch.empty(q_blocks + 1, 8))
+    layer.weight_loader(local_scale, q_scales, 0)
+    layer.weight_loader(local_scale, kv_scales, 1)
+    qs, qe = layer.component_ranges[0][1]
+    torch.testing.assert_close(local_scale[:q_blocks], q_scales[qs // 128 : qe // 128])
+    torch.testing.assert_close(local_scale[q_blocks:], kv_scales[0:1])
+
+
+def _arscatter_env(transport="arscatter"):
+    import vllm.model_executor.layers.glm_uneven_linear as glm_uneven_linear
+
+    return (
+        patch.dict(os.environ, {"VLLM_GLM_UNEVEN_GATHER": transport}),
+        patch.dict(glm_uneven_linear.__dict__, {"_GATHER_TRANSPORT": None}),
+    )
+
+
+def _arscatter_round(layers, x, ar_result, transport="arscatter"):
+    """One arscatter forward per rank with a fake tensor-parallel all-reduce.
+
+    With ``ar_result`` None the reduction is a no-op that records the slot
+    each rank would put on the wire; otherwise every rank receives the group
+    sum of a completed round, as the real collective returns.
+    """
+    recorded = []
+    if ar_result is None:
+
+        def fake_ar(t):
+            recorded.append(t)
+            return t
+
+    else:
+
+        def fake_ar(_):
+            return ar_result
+
+    env, cached = _arscatter_env(transport)
+    with (
+        env,
+        cached,
+        patch(
+            "vllm.model_executor.layers.glm_uneven_linear."
+            "tensor_model_parallel_all_reduce",
+            side_effect=fake_ar,
+        ),
+    ):
+        outputs = []
+        for layer in layers:
+            result = layer.forward(x)
+            outputs.append(result[0] if isinstance(result, tuple) else result)
+    return outputs, recorded
+
+
+def _assert_slots_zero_outside_owned(layer, slots):
+    zeros = slots.clone()
+    if hasattr(layer, "component_ranges"):
+        qs, qe = layer.component_ranges[0][layer.rank]
+        ks, ke = layer.component_ranges[1][layer.rank]
+        q_size = layer.component_sizes[0]
+        zeros[..., qs:qe] = 0
+        zeros[..., q_size + ks : q_size + ke] = 0
+    else:
+        zeros[..., layer.row_start : layer.row_end] = 0
+    assert zeros.abs().max().item() == 0
+
+
+def _run_arscatter_steps(layer_factory, x1, x2):
+    layers = []
+    for rank in range(WORLD):
+        with _tp_context(rank):
+            layers.append(layer_factory())
+    results = []
+    for x in (x1, x2):
+        _, recorded = _arscatter_round(layers, x, None)
+        assert len(recorded) == WORLD
+        summed = recorded[0].clone()
+        for other in recorded[1:]:
+            summed += other
+        results.append(summed)
+        outputs, _ = _arscatter_round(layers, x, summed)
+        for out in outputs:
+            torch.testing.assert_close(out, summed, rtol=0, atol=0)
+    # Two steps on the same persistent buffers: everything outside each
+    # rank's own rows must still be zero, so later rounds stay exact
+    # without any re-zeroing.
+    for layer in layers:
+        slots = next(iter(layer._scatter_slots.values()))
+        _assert_slots_zero_outside_owned(layer, slots)
+    return results
+
+
+def test_arscatter_transport_env_validation():
+    import vllm.model_executor.layers.glm_uneven_linear as glm_uneven_linear
+
+    env, cached = _arscatter_env()
+    with env, cached:
+        assert glm_uneven_linear.glm_uneven_gather_transport() == "arscatter"
+    with (
+        patch.dict(os.environ, {"VLLM_GLM_UNEVEN_GATHER": "carrier"}),
+        patch.dict(glm_uneven_linear.__dict__, {"_GATHER_TRANSPORT": None}),
+        pytest.raises(ValueError),
+    ):
+        glm_uneven_linear.glm_uneven_gather_transport()
+
+
+def test_arscatter_reconstructs_exactly_and_keeps_slots_zero():
+    torch.manual_seed(0)
+    input_size, output_size = 64, 2048
+    weight = torch.randn(output_size, input_size, dtype=torch.float64)
+
+    def factory():
+        layer = GlmUnevenColumnLinear(
+            input_size, output_size, block_size=128, params_dtype=torch.float64
+        )
+        layer.weight_loader(layer.weight, weight)
+        return layer
+
+    x1 = torch.randn(4, input_size, dtype=torch.float64)
+    x2 = torch.randn(4, input_size, dtype=torch.float64)
+    out1, out2 = _run_arscatter_steps(factory, x1, x2)
+    torch.testing.assert_close(out1, F.linear(x1, weight), rtol=0, atol=0)
+    torch.testing.assert_close(out2, F.linear(x2, weight), rtol=0, atol=0)
+
+
+def test_arscatter_fused_qkv_a_reconstructs_exactly():
+    from vllm.model_executor.layers.glm_uneven_linear import (
+        GlmUnevenFusedQkvALinear,
+    )
+
+    torch.manual_seed(0)
+    k, q_size, kv_size = 64, 2048, 576
+    weight = torch.randn(q_size + kv_size, k, dtype=torch.float64)
+
+    def factory():
+        layer = GlmUnevenFusedQkvALinear(
+            k, [q_size, kv_size], params_dtype=torch.float64
+        )
+        layer.weight_loader(layer.weight, weight[:q_size], 0)
+        layer.weight_loader(layer.weight, weight[q_size:], 1)
+        return layer
+
+    x1 = torch.randn(2, k, dtype=torch.float64)
+    x2 = torch.randn(2, k, dtype=torch.float64)
+    out1, out2 = _run_arscatter_steps(factory, x1, x2)
+    fused = torch.cat([weight[:q_size], weight[q_size:]])
+    torch.testing.assert_close(out1, F.linear(x1, fused), rtol=0, atol=0)
+    torch.testing.assert_close(out2, F.linear(x2, fused), rtol=0, atol=0)
+
+
+def test_arscatter_caches_only_decode_sized_batches():
+    torch.manual_seed(0)
+    input_size, output_size = 32, 576
+
+    def make(rows):
+        layer = GlmUnevenColumnLinear(
+            input_size, output_size, block_size=64, params_dtype=torch.float64
+        )
+        layer.weight_loader(
+            layer.weight,
+            torch.randn(output_size, input_size, dtype=torch.float64),
+        )
+        x = torch.randn(rows, input_size, dtype=torch.float64)
+        return layer, x
+
+    for rows in (4, 16, 64):
+        with _tp_context(3):
+            layer, x = make(rows)
+        _arscatter_round([layer], x, None)
+        assert len(layer._scatter_slots) == 1
+    with _tp_context(3):
+        layer, x = make(100)
+    for _ in range(2):
+        _, recorded = _arscatter_round([layer], x, None)
+    assert len(layer._scatter_slots) == 0
+    assert recorded[0].shape == (100, output_size)
+
+
+def test_argemm_fused_qkv_a_uses_direct_scatter_output():
+    from vllm.model_executor.layers.glm_uneven_linear import (
+        GlmUnevenFusedQkvALinear,
+    )
+
+    class DirectMethod:
+        supports_glm_scatter_out = True
+
+        def apply(self, layer, x, bias, out=None, scatter=None):
+            local = F.linear(x, layer.weight)
+            q_start, local_q, kv_dest_base = scatter
+            cols = torch.arange(local.shape[-1])
+            dest = torch.where(cols < local_q, q_start + cols, kv_dest_base + cols)
+            out[..., dest] = local
+            return out
+
+    torch.manual_seed(0)
+    k, q_size, kv_size = 64, 2048, 576
+    weight = torch.randn(q_size + kv_size, k, dtype=torch.float64)
+    layers = []
+    for rank in range(WORLD):
+        with _tp_context(rank):
+            layer = GlmUnevenFusedQkvALinear(
+                k, [q_size, kv_size], params_dtype=torch.float64
+            )
+        layer.weight_loader(layer.weight, weight[:q_size], 0)
+        layer.weight_loader(layer.weight, weight[q_size:], 1)
+        layer.quant_method = DirectMethod()
+        layers.append(layer)
+    x = torch.randn(4, k, dtype=torch.float64)
+    _, recorded = _arscatter_round(layers, x, None, transport="argemm")
+    summed = recorded[0].clone()
+    for other in recorded[1:]:
+        summed += other
+    outputs, _ = _arscatter_round(layers, x, summed, transport="argemm")
+    for out in outputs:
+        torch.testing.assert_close(out, F.linear(x, weight), rtol=0, atol=0)
+    for layer, slots in zip(layers, recorded):
+        _assert_slots_zero_outside_owned(layer, slots)
