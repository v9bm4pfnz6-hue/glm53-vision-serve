+    assert out.dtype == torch.bfloat16 and tuple(out.shape) == (rows, 8, 512)
+    assert torch.all(out == 1.0)
+    assert calls["partial"].dtype == torch.float32 and calls["base_e"] is True
+    assert torch.isinf(calls["lse"][2:]).all() and torch.isfinite(calls["lse"][:2]).all()
