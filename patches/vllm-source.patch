+def _dcp_mqa_combine_metadata(
+    attn_metadata: AttentionMetadata, backend_name: str
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return local KV lengths and query rows covered by the DCP MQA call."""
+    if backend_name == "B12X_MLA_SPARSE":
+        # B12X routes decode, verification, and prefill through the same MQA
+        # kernel. Its metadata has no nested decode view, and the collective
+        # must mask empty shards over every request in the current call.
+        num_reqs = attn_metadata.num_reqs  # type: ignore[attr-defined]
+        return (
+            attn_metadata.cache_seq_lens_per_req[:num_reqs],  # type: ignore[attr-defined]
+            attn_metadata.query_start_loc[: num_reqs + 1],  # type: ignore[attr-defined]
+        )
+
+    decode_metadata = attn_metadata.decode  # type: ignore[attr-defined]
+    seq_lens = (
+        decode_metadata.seq_lens
+        if decode_metadata is not None
+        else cast(torch.Tensor, attn_metadata.seq_lens)[  # type: ignore[attr-defined]
+            : attn_metadata.num_decodes  # type: ignore[attr-defined]
+        ]
+    )
+    query_start_loc = attn_metadata.query_start_loc[  # type: ignore[attr-defined]
+        : attn_metadata.num_decodes + 1  # type: ignore[attr-defined]
+    ]
+    return seq_lens, query_start_loc
