+def _is_glm_dcp9_q_model(
+    model_config: ModelConfig, speculative_config: Any | None
+) -> bool:
+    hf_config = model_config.hf_text_config
+    model_type = getattr(hf_config, "model_type", None)
+    if model_type == "glm_moe_dsa":
+        return True
+    if model_type != "deepseek_mtp" or speculative_config is None:
+        return False
+    target = getattr(speculative_config, "target_model_config", None)
+    return bool(
+        speculative_config.method == "mtp"
+        and "DeepSeekMTPModel" in (getattr(hf_config, "architectures", None) or ())
+        and target is not None
+        and getattr(target.hf_text_config, "model_type", None) == "glm_moe_dsa"
+    )
