+        dcp_group,
+        device=device,
+        total_heads=72,
+        head_dim=head_dim,
+        query_head_dim=576,
+        max_batch_size=_GLM_DCP9_B12X_Q_MAX_ROWS,
+        **({"output_elem_bytes": 4} if fp32_combine else {}),
+    )
