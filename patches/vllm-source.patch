+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.fused_moe.activation import MoEActivation
+from vllm.model_executor.layers.fused_moe.config import (
+    FusedMoEConfig,
+    FusedMoEParallelConfig,
+    RoutingMethodType,
+)
+from vllm.model_executor.layers.fused_moe.fused_moe_method_base import (
+    FusedMoEMethodBase,
+)
+from vllm.model_executor.layers.fused_moe.glm_fp8_tp9 import (
+    get_glm_fp8_tp9_shard,
+)
+from vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts
+from vllm.model_executor.layers.quantization.fp8 import Fp8Config, Fp8MoEMethod
+
+
+def test_glm_fp8_tp9_covers_original_blocks_once_and_balances_mtp():
+    """Every expert channel must belong to one rank, including the MTP layer."""
+    blocks_per_rank = [0] * 9
+
+    for layer_idx in range(3, 79):
+        blocks = []
+        for rank in range(9):
+            start, width = get_glm_fp8_tp9_shard(layer_idx, rank)
+            assert start % 128 == 0
+            assert width in (128, 256)
+            assert start + width <= 2048
+            blocks.extend(range(start // 128, (start + width) // 128))
+            blocks_per_rank[rank] += width // 128
+
+        assert sorted(blocks) == list(range(16))
+
+    assert sorted(blocks_per_rank) == [135] * 8 + [136]
+    with pytest.raises(ValueError, match="sparse or MTP"):
+        get_glm_fp8_tp9_shard(2, 0)
+    with pytest.raises(ValueError, match="rank 0..8"):
+        get_glm_fp8_tp9_shard(3, 9)
+
+
+def test_glm_fp8_tp9_reconstructs_gate_up_down_and_original_scales():
+    """The same channel slice must feed gate, up, and down projections."""
+    generator = torch.Generator().manual_seed(53)
+    gate_stored = torch.randint(-8, 9, (2048, 4), generator=generator)
+    up_stored = torch.randint(-8, 9, (2048, 4), generator=generator)
+    down_stored = torch.randint(-8, 9, (4, 2048), generator=generator)
+    gate_scales = torch.rand((16, 1), generator=generator) + 0.5
+    up_scales = torch.rand((16, 1), generator=generator) + 0.5
+    down_scales = torch.rand((1, 16), generator=generator) + 0.5
+    x = torch.rand((4,), generator=generator)
+
+    gate = gate_stored.float() * gate_scales.repeat_interleave(128, dim=0)
+    up = up_stored.float() * up_scales.repeat_interleave(128, dim=0)
+    down = down_stored.float() * down_scales.repeat_interleave(128, dim=1)
+    full = down @ (torch.nn.functional.silu(gate @ x) * (up @ x))
+
+    for layer_idx in (3, 4, 10, 77, 78):
+        reconstructed = torch.zeros_like(full)
+        for rank in range(9):
+            start, width = get_glm_fp8_tp9_shard(layer_idx, rank)
+            scale_start = start // 128
+            scale_width = width // 128
+
+            gate_slice = gate_stored[start : start + width].float()
+            gate_scale = gate_scales[scale_start : scale_start + scale_width]
+            up_slice = up_stored[start : start + width].float()
+            up_scale = up_scales[scale_start : scale_start + scale_width]
+            down_slice = down_stored[:, start : start + width].float()
+            down_scale = down_scales[:, scale_start : scale_start + scale_width]
+
+            local_gate = gate_slice * gate_scale.repeat_interleave(128, dim=0)
+            local_up = up_slice * up_scale.repeat_interleave(128, dim=0)
+            local_down = down_slice * down_scale.repeat_interleave(128, dim=1)
+            reconstructed += local_down @ (
+                torch.nn.functional.silu(local_gate @ x) * (local_up @ x)
+            )
+
+        torch.testing.assert_close(reconstructed, full, rtol=1e-5, atol=1e-3)
+
+
+@pytest.mark.parametrize("layer_idx,rank", [(3, 0), (3, 2), (4, 4)])
+def test_glm_fp8_tp9_routed_experts_loader_uses_original_block_offsets(
+    layer_idx: int, rank: int
+):
+    """The real loader must copy compact channel and scale slices from checkpoint."""
+    start, width = get_glm_fp8_tp9_shard(layer_idx, rank)
+    moe_config = SimpleNamespace(
+        glm_fp8_tp9_shard=(start, width),
+        intermediate_size=2048,
+        is_act_and_mul=True,
+        tp_size=9,
+        tp_rank=rank,
+        moe_parallel_config=SimpleNamespace(tp_size=9, tp_rank=rank),
+    )
+    routed = RoutedExperts.__new__(RoutedExperts)
+    torch.nn.Module.__init__(routed)
+    routed.moe_config = moe_config
+    routed.quant_config = None
+    routed.quant_method = SimpleNamespace()
+    routed.expert_map_manager = SimpleNamespace(map_global_to_local=lambda expert: 0)
+    routed._loaded_expert_biases = set()
+
+    generator = torch.Generator().manual_seed(79)
+    gate = torch.randint(0, 256, (2048, 4), dtype=torch.uint8, generator=generator)
+    up = torch.randint(0, 256, (2048, 4), dtype=torch.uint8, generator=generator)
+    down = torch.randint(0, 256, (4, 2048), dtype=torch.uint8, generator=generator)
+    gate_scales = torch.arange(16, dtype=torch.float32).unsqueeze(1) + 1
+    up_scales = gate_scales + 16
+    down_scales = gate_scales.T + 32
+
+    w13 = torch.nn.Parameter(
+        torch.empty((1, 2 * width, 4), dtype=torch.uint8), requires_grad=False
+    )
+    w2 = torch.nn.Parameter(
+        torch.empty((1, 4, width), dtype=torch.uint8), requires_grad=False
+    )
+    s13 = torch.nn.Parameter(torch.empty((1, 2 * width // 128, 1)))
+    s2 = torch.nn.Parameter(torch.empty((1, 1, width // 128)))
+    s13.quant_method = "block"
+    s2.quant_method = "block"
+
+    for param, source, name, shard in (
+        (w13, gate, "gate_proj.weight", "w1"),
+        (w13, up, "up_proj.weight", "w3"),
+        (w2, down, "down_proj.weight", "w2"),
+        (s13, gate_scales, "gate_proj.weight_scale_inv", "w1"),
+        (s13, up_scales, "up_proj.weight_scale_inv", "w3"),
+        (s2, down_scales, "down_proj.weight_scale_inv", "w2"),
+    ):
+        assert routed.weight_loader(param, source, name, shard, 0, return_success=True)
+
+    scale_start = start // 128
+    scale_width = width // 128
+    assert w13.shape[1] == 2 * width
+    assert w2.shape[2] == width
+    assert torch.equal(w13[0, :width], gate[start : start + width])
+    assert torch.equal(w13[0, width:], up[start : start + width])
+    assert torch.equal(w2[0], down[:, start : start + width])
+    assert torch.equal(
+        s13[0, :scale_width], gate_scales[scale_start : scale_start + scale_width]
+    )
+    assert torch.equal(
+        s13[0, scale_width:], up_scales[scale_start : scale_start + scale_width]
+    )
+    assert torch.equal(s2[0], down_scales[:, scale_start : scale_start + scale_width])
+
+
+@pytest.mark.parametrize("layer_idx,rank", [(3, 0), (3, 2)])
+def test_glm_fp8_tp9_fp8_method_allocates_ragged_expert_storage(
+    monkeypatch: pytest.MonkeyPatch, layer_idx: int, rank: int
+):
+    """A short rank must actually allocate half the FP8 expert weight bytes."""
+    start, width = get_glm_fp8_tp9_shard(layer_idx, rank)
+    parallel = FusedMoEParallelConfig.make_no_parallel()
+    parallel.tp_size = 9
+    parallel.tp_rank = rank
+    moe = FusedMoEConfig(
+        num_experts=1,
+        experts_per_token=1,
+        hidden_dim=128,
+        intermediate_size=2048,
+        num_local_experts=1,
+        num_logical_experts=1,
+        activation=MoEActivation.SILU,
+        device="cpu",
+        routing_method=RoutingMethodType.TopK,
+        moe_parallel_config=parallel,
+        in_dtype=torch.bfloat16,
+        glm_fp8_tp9_shard=(start, width),
+    )
+    method = Fp8MoEMethod.__new__(Fp8MoEMethod)
+    FusedMoEMethodBase.__init__(method, moe)
+    method.quant_config = Fp8Config(
+        is_checkpoint_fp8_serialized=True,
+        activation_scheme="dynamic",
+        weight_block_size=[128, 128],
+    )
+    method.weight_block_size = [128, 128]
+    method.block_quant = True
+    method.weight_scale_name = "weight_scale_inv"
+    monkeypatch.setattr(
+        "vllm.model_executor.layers.quantization.fp8."
+        "get_tensor_model_parallel_world_size",
+        lambda: 9,
+    )
+    layer = torch.nn.Module()
+    method.create_weights(
+        layer,
+        num_experts=1,
+        hidden_size=128,
+        intermediate_size_per_partition=moe.intermediate_size_per_partition,
+        params_dtype=torch.bfloat16,
+    )
+
+    assert layer.w13_weight.dtype == torch.float8_e4m3fn
+    assert layer.w13_weight.shape == (1, 2 * width, 128)
+    assert layer.w2_weight.shape == (1, 128, width)
+    assert layer.w13_weight_scale_inv.shape == (1, 2 * width // 128, 1)
+    assert layer.w2_weight_scale_inv.shape == (1, 1, width // 128)
