+    )
+
+    model_config = _model_config(MODEL, limit_mm_per_prompt={"vision_chunk": 2})
+    tokenizer = cached_tokenizer_from_config(model_config)
+    buffer = io.BytesIO()
+    Image.new("RGB", (56, 56), (0, 120, 200)).save(buffer, format="PNG")
+    data_url = "data:image/png;base64," + base64.b64encode(buffer.getvalue()).decode()
+    messages = [
+        {"role": "system", "content": "You are terse."},
+        {
+            "role": "user",
+            "content": [
+                {"type": "image_url", "image_url": {"url": data_url}},
+                {"type": "text", "text": "What color is this?"},
+            ],
+        },
+    ]
+    content_format = resolve_chat_template_content_format(
+        None, None, "auto", tokenizer, model_config=model_config
+    )
+    assert content_format == "openai"
+    conversation, mm_data, _ = parse_chat_messages(
+        messages, model_config, content_format
+    )
+    assert mm_data is not None and len(mm_data["vision_chunk"]) == 1
+    prompt = safe_apply_chat_template(
+        model_config,
+        tokenizer,
+        conversation,
+        tools=None,
+        chat_template=None,
+        tokenize=False,
+        add_generation_prompt=True,
+    )
+    assert prompt.count("<|begin_of_image|><|image|><|end_of_image|>") == 1
+    assert "You are terse." in prompt and "What color is this?" in prompt
+    assert "unable to process" not in prompt
+
+    text_only = [{"role": "user", "content": "hi"}]
+    conversation, mm_data, _ = parse_chat_messages(
+        text_only, model_config, content_format
+    )
+    assert mm_data is None
+    reference = _model_config(TEXT_REFERENCE)
+    reference_prompt = safe_apply_chat_template(
+        reference,
+        cached_tokenizer_from_config(reference),
+        conversation,
+        tools=None,
+        chat_template=None,
+        tokenize=False,
+        add_generation_prompt=True,
+    )
+    composite_prompt = safe_apply_chat_template(
+        model_config,
+        tokenizer,
+        conversation,
+        tools=None,
+        chat_template=None,
+        tokenize=False,
+        add_generation_prompt=True,
+    )
+    assert composite_prompt == reference_prompt
