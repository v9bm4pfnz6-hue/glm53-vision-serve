+    if fp32_combine:
+        pool.prepare_graph_lse_reduce_scatter(
+            dtype=torch.float32,
+            out_dtype=torch.bfloat16,
+            channel_id=_B12X_DCP_EAGER_CHANNEL_ID,
+        )
