+def _gather_glm_dcp9_b12x_q(
+    local_q: torch.Tensor,
+    dcp_group: GroupCoordinator,
+    *,
+    output_head_dim: int = 512,
+) -> torch.Tensor:
+    if (
+        local_q.dtype != torch.bfloat16
+        or local_q.ndim != 3
+        or tuple(local_q.shape[1:]) != (8, 576)
+        or not 0 < local_q.shape[0] <= _GLM_DCP9_B12X_Q_MAX_ROWS
+        or dcp_group.world_size != 9
+    ):
+        raise ValueError("GLM DCP9 B12X Q gather received an invalid query shard")
+    gathered_q = _try_b12x_dcp_all_gather_heads(
+        local_q.contiguous(),
+        dcp_group,
+        max_batch_size=_GLM_DCP9_B12X_Q_MAX_ROWS,
+        output_head_dim=output_head_dim,
+    )
+    if (
+        gathered_q is None
+        or gathered_q.dtype != torch.bfloat16
+        or tuple(gathered_q.shape) != (local_q.shape[0], 72, 576)
+    ):
+        raise RuntimeError("GLM DCP9 B12X Q gather did not return 72 BF16 heads")
+    return gathered_q
