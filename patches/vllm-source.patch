+def _combine_glm_dcp9_b12x_fp32(
+    attn_out: torch.Tensor,
+    lse: torch.Tensor,
+    dcp_group: GroupCoordinator,
+    *,
+    is_lse_base_on_e: bool,
+    seq_lens: torch.Tensor | None,
+    query_start_loc: torch.Tensor | None,
+    head_dim: int = 512,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Combine FP32 rank-local sparse-MLA partials over nine DCP ranks.
+
+    Each rank pushes its FP32 partial head outputs and FP32 LSE for the owner
+    rank's eight heads through the B12X PCIe channel; the owner weights them
+    by exp(lse - max) / sum, accumulates in FP64 and rounds once to BF16.
+    Replaces the NCCL LSE all-gather, correction kernel, FP32 reduce-scatter
+    and the BF16 cast of the generic path with one launch. ``head_dim`` is 512
+    for the latent partials and 256 for value-projected partials
+    (VLLM_GLM_DCP9_PROJECT_BEFORE_COMBINE); ``out`` may be the caller's BF16
+    ``[rows, 8, head_dim]`` destination.
+    """
+    if (
+        attn_out.dtype != torch.float32
+        or attn_out.ndim != 3
+        or tuple(attn_out.shape[1:]) != (72, head_dim)
+        or not 0 < attn_out.shape[0] <= _GLM_DCP9_B12X_Q_MAX_ROWS
+        or dcp_group.world_size != 9
+        or lse.dtype != torch.float32
+        or tuple(lse.shape) != tuple(attn_out.shape[:2])
+    ):
+        raise ValueError("GLM DCP9 B12X FP32 combine received an invalid partial")
+    pool = _glm_dcp9_b12x_pool(
+        dcp_group, attn_out.device, fp32_combine=True, head_dim=head_dim
+    )
+    if pool is None:
+        raise RuntimeError("GLM DCP9 B12X FP32 combine pool is unavailable")
+    lse = lse.contiguous()
+    # Ranks without KV for a request contribute zero weight, as in the NCCL path.
+    mask_dcp_empty_shards_(lse, seq_lens, query_start_loc)
+    if not _is_supported_bhd_layout(attn_out):
+        attn_out = attn_out.contiguous()
+    if out is None:
+        out = torch.empty(
+            (attn_out.shape[0], 8, head_dim),
+            dtype=torch.bfloat16,
+            device=attn_out.device,
+        )
+    elif (
+        out.dtype != torch.bfloat16
+        or tuple(out.shape) != (attn_out.shape[0], 8, head_dim)
+        or not _is_supported_bhd_layout(out)
+    ):
+        raise ValueError("GLM DCP9 B12X FP32 combine received an invalid output")
+    result = pool.lse_reduce_scatter(
+        attn_out,
+        lse,
+        out=out,
+        is_lse_base_on_e=is_lse_base_on_e,
+        channel_id=_b12x_dcp_channel_id(dcp_group),
+    )
+    if result is not out:
+        raise RuntimeError("GLM DCP9 B12X FP32 combine did not write its output")
+    return out
+
