+def _prepare_glm_dcp9_b12x_q_pool(
+    dcp_group: GroupCoordinator,
+    device: torch.device,
+    *,
+    fp32_combine: bool = False,
+    head_dim: int = 512,
+) -> None:
+    pool = _glm_dcp9_b12x_pool(
+        dcp_group, device, fp32_combine=fp32_combine, head_dim=head_dim
+    )
+    if pool is None:
+        raise RuntimeError("GLM DCP9 B12X Q gather pool is unavailable")
