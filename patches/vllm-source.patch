@@ -0,0 +1,249 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Committed attention-tail reuse with MTP's draft rewind preserved."""
+
+import pytest
+
+from tests.v1.core.test_prefix_caching import (
+    make_kv_cache_config,
+    make_kv_cache_manager,
+    make_request,
+)
+from vllm.utils.hashing import sha256
+from vllm.v1.core.kv_cache_utils import init_none_hash
+
+UNIT = 64
+
+
+@pytest.fixture(autouse=True)
+def _hash_fn():
+    init_none_hash(sha256)
+
+
+def _manager(enabled=True, num_blocks=32, max_model_len=1024, replay=64, dcp=1):
+    return make_kv_cache_manager(
+        make_kv_cache_config(UNIT, num_blocks),
+        max_model_len=max_model_len,
+        scheduler_block_size=UNIT * dcp,
+        hash_block_size=UNIT,
+        dcp_world_size=dcp,
+        enable_caching=True,
+        use_eagle=True,
+        glm_attention_tail_cache=enabled,
+        glm_tail_replay_tokens=replay,
+    )
+
+
+def _producer(manager, tokens):
+    request = make_request("producer", tokens, UNIT, sha256)
+    blocks, hit, _ = manager.get_computed_blocks(request)
+    assert hit == 0
+    assert manager.allocate_slots(request, len(tokens), hit, blocks) is not None
+    request.append_output_token_ids([999])
+    request.num_computed_tokens = len(tokens)
+    return request
+
+
+def test_same_prompt_uses_exact_tail_with_draft_rewind_and_cow():
+    manager = _manager()
+    tokens = list(range(137))
+    producer = _producer(manager, tokens)
+    source = manager.coordinator.single_type_managers[0].req_to_blocks[
+        producer.request_id
+    ][1]
+    assert manager.cache_glm_attention_tails(producer) == 1
+    manager.free(producer)
+
+    consumer = make_request("consumer", tokens, UNIT, sha256)
+    blocks, hit, _ = manager.get_computed_blocks(consumer)
+    assert hit == 73  # Recompute exactly the final 64 prompt tokens for MTP.
+    assert blocks.blocks[0][-1] is source
+    assert manager.allocate_slots(consumer, len(tokens) - hit, hit, blocks) is not None
+    copies, retained = manager.take_kv_cache_block_copies()
+    assert len(copies) == 1
+    assert copies[0].src_block_id == source.block_id
+    assert copies[0].dst_block_id != source.block_id
+    assert copies[0].kv_cache_group_id == 0
+    assert source in retained
+    assert (
+        manager.coordinator.single_type_managers[0]
+        .req_to_blocks[consumer.request_id][1]
+        .block_id
+        == copies[0].dst_block_id
+    )
+
+
+def test_tail_key_checks_exact_tokens_and_cache_salt():
+    manager = _manager()
+    tokens = list(range(137))
+    producer = _producer(manager, tokens)
+    assert manager.cache_glm_attention_tails(producer) == 1
+    manager.free(producer)
+
+    for name, prompt, salt in (
+        ("different-tail", tokens[:70] + [800] + tokens[71:], None),
+        ("different-salt", tokens, "another-session"),
+    ):
+        consumer = make_request(name, prompt, UNIT, sha256, cache_salt=salt)
+        _, hit, _ = manager.get_computed_blocks(consumer)
+        assert hit <= 64
+
+
+def test_disabled_feature_does_not_publish_or_match_tail():
+    manager = _manager(enabled=False)
+    tokens = list(range(137))
+    producer = _producer(manager, tokens)
+    assert manager.cache_glm_attention_tails(producer) == 0
+    manager.free(producer)
+    consumer = make_request("consumer", tokens, UNIT, sha256)
+    _, hit, _ = manager.get_computed_blocks(consumer)
+    assert hit == 64
+
+
+@pytest.mark.parametrize("dcp", [1, 9])
+def test_followup_prefix_uses_generated_endpoint_and_reset_removes_it(dcp):
+    manager = _manager(dcp=dcp)
+    prompt = list(range(137))
+    producer = _producer(manager, prompt)
+    generated = list(range(500, 570))
+    producer.append_output_token_ids(generated)
+    assert manager.allocate_slots(producer, len(generated) - 1) is not None
+    producer.num_computed_tokens = producer.num_tokens - 1
+    assert manager.cache_glm_attention_tails(producer) == 2
+    manager.free(producer)
+
+    followup = make_request(
+        "followup", prompt + [999] + generated + list(range(10)), UNIT, sha256
+    )
+    blocks, hit, _ = manager.get_computed_blocks(followup)
+    assert hit == producer.num_computed_tokens - UNIT
+    assert blocks.blocks[0][-1].block_hash is not None
+    assert manager.reset_prefix_cache()
+    _, after_reset, _ = manager.get_computed_blocks(followup)
+    assert after_reset == 0
+
+
+@pytest.mark.parametrize("prompt_length", [8192, 16384])
+def test_aligned_prompt_keeps_one_mtp_rewind_block(prompt_length):
+    tokens = list(range(prompt_length))
+    baseline_manager = _manager(num_blocks=300, max_model_len=prompt_length + 64)
+    baseline_producer = _producer(baseline_manager, tokens)
+    baseline_manager.free(baseline_producer)
+    replay = make_request("replay", tokens, UNIT, sha256)
+    _, baseline, _ = baseline_manager.get_computed_blocks(replay)
+    assert baseline == prompt_length - 2 * UNIT
+
+    manager = _manager(num_blocks=300, max_model_len=prompt_length + 64)
+    producer = _producer(manager, tokens)
+    assert manager.cache_glm_attention_tails(producer) == 1
+    manager.free(producer)
+    _, exact, _ = manager.get_computed_blocks(replay)
+    assert exact == prompt_length - UNIT
+
+
+@pytest.mark.parametrize(
+    "replay,entry_limit,expected_hit",
+    [(64, 1, 64), (64, 2, 73), (4, 1, 64), (4, 2, 133)],
+)
+def test_longer_producer_cannot_bypass_consumers_mtp_rewind(
+    replay, entry_limit, expected_hit
+):
+    manager = _manager(replay=replay)
+    prompt = list(range(137))
+    producer = _producer(manager, prompt)
+    producer.append_output_token_ids(list(range(500, 507)))
+    assert manager.allocate_slots(producer, 7) is not None
+    producer.num_computed_tokens = producer.num_tokens - 1
+    assert manager.cache_glm_attention_tails(producer, max_entries=entry_limit) == 2
+    manager.free(producer)
+
+    replay = make_request("replay", prompt, UNIT, sha256)
+    _, hit, _ = manager.get_computed_blocks(replay)
+    assert hit == expected_hit
+
+
+@pytest.mark.parametrize("dcp", [1, 9])
+@pytest.mark.parametrize("replay,expected", [(64, 73), (4, 133)])
+def test_stop_truncation_never_publishes_tentative_mtp_rows(
+    replay, expected, dcp
+):
+    manager = _manager(replay=replay, dcp=dcp)
+    prompt = list(range(137))
+    producer = _producer(manager, prompt)
+    # A later speculative step may already be scheduled when a stop condition
+    # retains only the first emitted token. Its four tentative rows are not a
+    # committed prefix and cannot justify a longer endpoint.
+    producer.num_computed_tokens += 4
+    producer.num_in_flight_tokens = 4
+    assert manager.cache_glm_attention_tails(producer) == 1
+    assert [
+        entry.num_tokens
+        for entries in manager.block_pool.endpoint_entries.values()
+        for entry in entries
+    ] == [expected]
+    manager.free(producer)
+    followup = make_request("followup", prompt + [999, 777], UNIT, sha256)
+    _, hit, _ = manager.get_computed_blocks(followup)
+    assert hit == expected
+
+
+@pytest.mark.parametrize("prompt_length", [137, 8192])
+def test_replay_four_keeps_exactly_four_target_tokens(prompt_length):
+    manager = _manager(num_blocks=200, max_model_len=prompt_length + 64, replay=4)
+    prompt = list(range(prompt_length))
+    producer = _producer(manager, prompt)
+    assert manager.cache_glm_attention_tails(producer) == 1
+    manager.free(producer)
+    replay = make_request("replay", prompt, UNIT, sha256)
+    blocks, hit, _ = manager.get_computed_blocks(replay)
+    assert hit == prompt_length - 4
+    assert manager.allocate_slots(replay, prompt_length - hit, hit, blocks) is not None
+    copies, _ = manager.take_kv_cache_block_copies()
+    assert len(copies) == 1
+
+
+def test_replay_four_rejection_and_longer_producer_bound():
+    manager = _manager(replay=4)
+    prompt = list(range(137))
+    producer = _producer(manager, prompt)
+    producer.append_output_token_ids([800, 801, 802])
+    # The rejected suffix remains in the request's token list temporarily,
+    # while the committed target KV count has already rolled back.
+    producer.num_computed_tokens = 137
+    assert manager.cache_glm_attention_tails(producer) == 1
+    manager.free(producer)
+    shorter = make_request("shorter", prompt, UNIT, sha256)
+    _, hit, _ = manager.get_computed_blocks(shorter)
+    assert hit == 133
+
+
+def test_one_token_replay_is_rejected_until_draft_kv_is_proven():
+    with pytest.raises(ValueError, match="only 4 or 64"):
+        _manager(replay=1)
+
+
+@pytest.mark.parametrize("prompt_length", [137, 585, 650])
+@pytest.mark.parametrize("replay", [4, 64])
+def test_dcp9_tail_resume_copies_sharded_page(prompt_length, replay):
+    manager = _manager(dcp=9, replay=replay)
+    prompt = list(range(prompt_length))
+    producer = _producer(manager, prompt)
+    assert manager.supports_glm_attention_tails()
+    assert manager.cache_glm_attention_tails(producer) == 1
+    manager.free(producer)
+
+    consumer = make_request("consumer", prompt, UNIT, sha256)
+    blocks, hit, _ = manager.get_computed_blocks(consumer)
+    assert hit == prompt_length - replay
+    source = blocks.blocks[0][-1]
+    assert manager.allocate_slots(
+        consumer, prompt_length - hit, hit, blocks
+    ) is not None
+    copies, retained = manager.take_kv_cache_block_copies()
+    assert len(copies) == 1
+    assert copies[0].src_block_id == source.block_id
+    assert copies[0].kv_cache_group_id == 0
+    assert source in retained
+    assert copies[0].dst_block_id != source.block_id
+    assert manager.coordinator.single_type_managers[0].req_to_blocks[
+        consumer.request_id
+    ][(hit - 1) // (UNIT * 9)].block_id == copies[0].dst_block_id
