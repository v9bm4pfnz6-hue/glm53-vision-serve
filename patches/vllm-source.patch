+def _glm_dcp9_b12x_pool(
+    dcp_group: GroupCoordinator,
+    device: torch.device,
+    *,
+    fp32_combine: bool,
+    head_dim: int = 512,
+) -> Any:
+    # With the FP32 combine the staging rows must hold head_dim FP32 partial
+    # elements (2048 B for the 512-wide latent, 1024 B for the value-projected
+    # 256-wide partial) or 576 BF16 query elements (1152 B), whichever is wider.
