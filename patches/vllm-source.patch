+    assert getattr(draft_config, VIRTUAL_TP_PLAN_ATTR)["sharding"] == plan["sharding"]
+    assert draft_config.num_attention_heads == 72
+    assert draft_config.intermediate_size == 12672
+    assert draft_config.moe_intermediate_size == 2048
+
+
+def test_glm_fp8_tp9_rejects_missing_mtp(monkeypatch: pytest.MonkeyPatch):
