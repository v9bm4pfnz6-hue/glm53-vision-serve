+# SPDX-License-Identifier: Apache-2.0
+"""The V1 MTP proposer refreshes DCP metadata after each draft step."""
+
+from types import SimpleNamespace
+
+import torch
+
+import vllm.v1.spec_decode.llm_base_proposer as proposer_module
+from vllm.v1.spec_decode.llm_base_proposer import SpecDecodeBaseProposer
+
+
+def test_glm_dcp9_mtp_refreshes_exact_local_lengths_and_positions(monkeypatch):
+    proposer = object.__new__(SpecDecodeBaseProposer)
+    proposer.method = "mtp"
+    proposer.vllm_config = SimpleNamespace(
+        model_config=SimpleNamespace(
+            hf_text_config=SimpleNamespace(model_type="glm_moe_dsa")
+        ),
+        parallel_config=SimpleNamespace(
+            tensor_parallel_size=9,
+            decode_context_parallel_size=9,
+            cp_kv_cache_interleave_size=1,
+        ),
+    )
+    positions = torch.tensor([104, 202, 1234], dtype=torch.int64)
+    proposer._get_positions = lambda count: positions[:count]
+    seen = []
+
+    def prepare(out, global_lengths, num_reqs, cp_size, cp_rank, interleave):
+        seen.append((num_reqs, cp_size, cp_rank, interleave))
+        for idx in range(num_reqs):
+            out[idx] = sum(
+                position % cp_size == cp_rank
+                for position in range(int(global_lengths[idx]))
+            )
+
+    monkeypatch.setattr(proposer_module, "prepare_dcp_local_seq_lens", prepare)
+    monkeypatch.setattr(
+        proposer_module,
+        "get_dcp_group",
+        lambda: SimpleNamespace(rank_in_group=7),
+    )
+    metadata = SimpleNamespace(
+        dcp_local_seq_lens=torch.full((2,), -1, dtype=torch.int32),
+        seq_lens=torch.tensor([105, 203], dtype=torch.int32),
+        num_reqs=2,
+        positions=None,
+    )
+
+    proposer._refresh_glm_dcp9_draft_metadata(metadata, 2)
+
+    assert seen == [(2, 9, 7, 1)]
+    assert metadata.dcp_local_seq_lens.tolist() == [11, 22]
+    assert metadata.positions.data_ptr() == positions.data_ptr()
+
+
+def test_glm_dcp9_mtp_gate_does_not_affect_other_drafts():
+    proposer = object.__new__(SpecDecodeBaseProposer)
+    proposer.method = "mtp"
+    proposer.vllm_config = SimpleNamespace(
+        model_config=SimpleNamespace(
+            hf_text_config=SimpleNamespace(model_type="deepseek_v32")
+        ),
+        parallel_config=SimpleNamespace(
+            tensor_parallel_size=9,
+            decode_context_parallel_size=9,
+        ),
+    )
+    assert not proposer._glm_dcp9_mtp()
