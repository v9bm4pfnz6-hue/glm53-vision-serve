+# SPDX-License-Identifier: Apache-2.0
+"""Exact DCP causal masks after rejected speculative tokens."""
+
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tests.v1.attention.utils import BatchSpec, create_common_attn_metadata
+from vllm.v1.attention.backends.mla.b12x_mla_sparse import (
+    B12xMLASparseMetadataBuilder,
+)
+from vllm.v1.attention.backends.mla.indexer import (
+    DeepseekV32IndexerMetadataBuilder,
+)
+
+
+def _local_length(global_length: int, rank: int, world: int) -> int:
+    return sum(position % world == rank for position in range(global_length))
+
+
+@pytest.mark.parametrize("rank", range(9))
+@pytest.mark.parametrize("rejected", range(4))
+def test_glm_dcp9_multi_token_uses_exact_positions_not_optimistic_bound(
+    monkeypatch: pytest.MonkeyPatch, rank: int, rejected: int
+) -> None:
+    from vllm.distributed import parallel_state
+
+    # The metadata builder stages CPU request ids through pinned memory in
+    # production. CPU-only qualification has no CUDA driver for pin_memory().
+    monkeypatch.setattr(torch.Tensor, "pin_memory", lambda self: self)
+    monkeypatch.setattr(
+        parallel_state,
+        "get_dcp_group",
+        lambda: SimpleNamespace(rank_in_group=rank),
+    )
+    hf = SimpleNamespace(
+        index_topk=2048,
+        kv_lora_rank=512,
+        qk_nope_head_dim=512,
+        qk_rope_head_dim=64,
+        v_head_dim=512,
+    )
+    config = SimpleNamespace(
+        model_config=SimpleNamespace(hf_config=hf, hf_text_config=hf),
+        parallel_config=SimpleNamespace(
+            decode_context_parallel_size=9,
+            cp_kv_cache_interleave_size=1,
+        ),
+        scheduler_config=SimpleNamespace(
+            max_num_batched_tokens=8,
+            max_num_seqs=2,
+        ),
+    )
+    # Four verification rows plus a shorter second request. The CPU bound
+    # assumes 0..3 draft tokens were accepted when they were rejected.
+    metadata = create_common_attn_metadata(
+        BatchSpec(seq_lens=[104, 202], query_lens=[4, 2]),
+        block_size=64,
+        device=torch.device("cpu"),
+    )
+    metadata.positions = torch.tensor(
+        [100, 101, 102, 103, 200, 201, 1234, 1234], dtype=torch.int64
+    )
+    metadata.num_actual_tokens = 8  # Two graph-padding rows must stay masked.
+    metadata.seq_lens_cpu_upper_bound = torch.tensor(
+        [104 + rejected, 202 + rejected], dtype=torch.int32
+    )
+    metadata.dcp_local_seq_lens = torch.tensor(
+        [_local_length(104, rank, 9), _local_length(202, rank, 9)],
+        dtype=torch.int32,
+    )
+    builder = B12xMLASparseMetadataBuilder(
+        SimpleNamespace(block_size=64),
+        ["placeholder"],
+        config,
+        torch.device("cpu"),
+    )
+
+    result = builder.build(0, metadata)
+
+    assert result.cache_seq_lens_per_token.tolist() == [
+        *[_local_length(position + 1, rank, 9) for position in range(100, 104)],
+        *[_local_length(position + 1, rank, 9) for position in range(200, 202)],
+        0,
+        0,
+    ]
+    assert result.cache_seq_lens_per_req.tolist() == [
+        _local_length(104, rank, 9),
+        _local_length(202, rank, 9),
+    ]
+
+
+def test_indexer_ignores_optimistic_dcp_cpu_shadow_in_async_spec() -> None:
+    builder = object.__new__(DeepseekV32IndexerMetadataBuilder)
+    builder.compress_ratio = 1
+    local_shadow = torch.tensor([13, 24], dtype=torch.int32)
+    common = SimpleNamespace(_seq_lens_cpu=None)
+    assert builder._decode_topk_max_seq_len_from_cpu(
+        common,
+        num_decodes=2,
+        decode_lens_np=np.array([4, 2], dtype=np.int32),
+        max_decode_len=4,
+        use_native=True,
+        dcp_local_seq_lens_cpu=local_shadow,
+    ) is None
+
+    common._seq_lens_cpu = torch.tensor([104, 202], dtype=torch.int32)
+    assert builder._decode_topk_max_seq_len_from_cpu(
+        common,
+        num_decodes=2,
+        decode_lens_np=np.array([4, 2], dtype=np.int32),
+        max_decode_len=4,
+        use_native=True,
+        dcp_local_seq_lens_cpu=local_shadow,
+    ) == 24
