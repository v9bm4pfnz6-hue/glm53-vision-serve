+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GLM-5.3-Vision: MoonViT TP padding plan and exactness of the padded math."""
+
+from types import SimpleNamespace
+from typing import Any, cast
+
+import pytest
+import torch
+
+from vllm.config import ParallelConfig
+from vllm.config.virtual_tp import (
+    VIRTUAL_TP_PLAN_ATTR,
+    maybe_apply_b12x_virtual_tp_padding,
+)
+from vllm.model_executor.models.glm5v import _pad_dim, _pad_fused_qkv
+from vllm.v1.attention.backends.registry import AttentionBackendEnum
+
+TP = 9
+HEADS, HEAD_DIM, HIDDEN, INTER = 16, 72, 1152, 4304
+
+
+def _text_config() -> SimpleNamespace:
+    return SimpleNamespace(
+        model_type="glm_moe_dsa",
+        architectures=["GlmMoeDsaForCausalLM"],
+        hidden_size=6144,
+        num_attention_heads=64,
+        qk_nope_head_dim=128,
+        qk_rope_head_dim=64,
+        kv_lora_rank=512,
+        index_topk=2048,
+        index_n_heads=32,
+        intermediate_size=12288,
+        moe_intermediate_size=2048,
+        n_routed_experts=256,
+        n_shared_experts=1,
+        num_hidden_layers=78,
+        first_k_dense_replace=3,
+        vocab_size=154880,
+        quantization_config={
+            "quant_method": "fp8",
+            "activation_scheme": "dynamic",
+            "fmt": "e4m3",
+            "weight_block_size": [128, 128],
+        },
+    )
+
+
+def _vision_config() -> SimpleNamespace:
+    return SimpleNamespace(
+        num_attention_heads=HEADS,
+        vt_num_attention_heads=HEADS,
+        hidden_size=HIDDEN,
+        intermediate_size=INTER,
+        vt_intermediate_size=INTER,
+        merge_kernel_size=[2, 2],
+    )
+
+
+class FakeGlm5vModelConfig:
+    def __init__(self, *, mm_encoder_tp_mode: str = "weights"):
+        self.hf_text_config = _text_config()
+        self.hf_config = SimpleNamespace(
+            model_type="glm5v",
+            architectures=["Glm5vForConditionalGeneration"],
+            text_config=self.hf_text_config,
+            vision_config=_vision_config(),
+        )
+        self.multimodal_config = SimpleNamespace(mm_encoder_tp_mode=mm_encoder_tp_mode)
+        self.model_arch_config = self.get_model_arch_config()
+
+    def get_model_arch_config(self):
+        return SimpleNamespace(
+            total_num_attention_heads=self.hf_text_config.num_attention_heads,
+        )
+
+    def verify_with_parallel_config(self, parallel_config):
+        assert self.hf_text_config.num_attention_heads % TP == 0
+
+
+def _vllm_config(model_config: Any) -> SimpleNamespace:
+    return SimpleNamespace(
+        model_config=model_config,
+        parallel_config=ParallelConfig(tensor_parallel_size=TP),
+        kernel_config=SimpleNamespace(moe_backend="triton"),
+        attention_config=SimpleNamespace(backend=AttentionBackendEnum.B12X_MLA_SPARSE),
+        quant_config=None,
+        speculative_config=SimpleNamespace(method="mtp"),
+    )
+
+
+def test_glm_fp8_tp9_pads_vision_tower_for_tp9(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setenv("VLLM_GLM_FP8_TP9", "1")
+    model_config = FakeGlm5vModelConfig()
+    maybe_apply_b12x_virtual_tp_padding(cast(Any, _vllm_config(model_config)))
+
+    text = model_config.hf_text_config
+    assert text.num_attention_heads == 72
+    assert text.intermediate_size == 12672
+    assert text.moe_intermediate_size == 2048
+
+    vision = model_config.hf_config.vision_config
+    plan = getattr(vision, VIRTUAL_TP_PLAN_ATTR)
+    assert plan["sharding"] == "glm-fp8-block-tp9"
+    assert plan["vision_attention_heads"] == {
+        "original_size": 16,
+        "padded_size": 18,
+        "tp_size": 9,
+        "local_size": 2,
+    }
+    assert plan["vision_qkv_hidden_size"] == {
+        "original_size": 1152,
+        "padded_size": 1296,
+        "tp_size": 9,
+        "local_size": 144,
+    }
+    assert plan["vision_intermediate_size"] == {
+        "original_size": 4304,
+        "padded_size": 4320,
+        "tp_size": 9,
+        "local_size": 480,
+    }
+    assert plan["vision_projector_hidden_size"] == {
+        "original_size": 4608,
+        "padded_size": 4608,
+        "tp_size": 9,
+        "local_size": 512,
+    }
+    assert vision.num_attention_heads == vision.vt_num_attention_heads == 18
+    assert vision.original_num_attention_heads == 16
+    assert vision.qkv_hidden_size == 1296
+    assert vision.original_qkv_hidden_size == 1152
+    assert vision.intermediate_size == vision.vt_intermediate_size == 4320
+    assert vision.original_intermediate_size == 4304
+    assert vision.hidden_size == 1152
+
+
+def test_glm_fp8_tp9_leaves_data_parallel_vision_tower_alone(
+    monkeypatch: pytest.MonkeyPatch,
+):
+    monkeypatch.setenv("VLLM_GLM_FP8_TP9", "1")
+    model_config = FakeGlm5vModelConfig(mm_encoder_tp_mode="data")
+    maybe_apply_b12x_virtual_tp_padding(cast(Any, _vllm_config(model_config)))
+    vision = model_config.hf_config.vision_config
+    assert vision.num_attention_heads == 16
+    assert vision.intermediate_size == 4304
+    assert not hasattr(vision, "qkv_hidden_size")
+    assert "vision_attention_heads" not in getattr(
+        model_config.hf_text_config, VIRTUAL_TP_PLAN_ATTR
+    )
+
+
+def _reference_block(x, wqkv, bqkv, wo, bo, w0, b0, w1, b1, heads, head_dim):
+    """One MoonViT block without norms/rope: attention + MLP (float64)."""
+    n = x.shape[0]
+    qkv = x @ wqkv.T + bqkv
+    width = heads * head_dim
+    q, k, v = qkv[:, :width], qkv[:, width : 2 * width], qkv[:, 2 * width :]
+    q = q.view(n, heads, head_dim).transpose(0, 1)
+    k = k.view(n, heads, head_dim).transpose(0, 1)
+    v = v.view(n, heads, head_dim).transpose(0, 1)
+    attn = torch.softmax((q @ k.transpose(1, 2)) * head_dim**-0.5, dim=-1) @ v
+    attn = attn.transpose(0, 1).reshape(n, width)
+    y = x + attn @ wo.T + bo
+    h = torch.nn.functional.gelu(y @ w0.T + b0)
+    return y + h @ w1.T + b1
+
+
+def test_glm5v_padded_tp9_block_matches_unpadded_block():
+    """Zero-padded heads/channels sharded over nine ranks reproduce the block."""
+    torch.manual_seed(53)
+    dtype = torch.float64
+    n = 7
+    width = HEADS * HEAD_DIM
+    x = torch.randn(n, HIDDEN, dtype=dtype)
+    wqkv = torch.randn(3 * width, HIDDEN, dtype=dtype) * 0.05
+    bqkv = torch.randn(3 * width, dtype=dtype) * 0.05
+    wo = torch.randn(HIDDEN, width, dtype=dtype) * 0.05
+    bo = torch.randn(HIDDEN, dtype=dtype) * 0.05
+    w0 = torch.randn(INTER, HIDDEN, dtype=dtype) * 0.05
+    b0 = torch.randn(INTER, dtype=dtype) * 0.05
+    w1 = torch.randn(HIDDEN, INTER, dtype=dtype) * 0.05
+    b1 = torch.randn(HIDDEN, dtype=dtype) * 0.05
+    reference = _reference_block(x, wqkv, bqkv, wo, bo, w0, b0, w1, b1, HEADS, HEAD_DIM)
+
+    padded_heads, padded_width, padded_inter = 18, 18 * HEAD_DIM, 4320
+    pqkv = _pad_fused_qkv(wqkv, width, padded_width)
+    pbqkv = _pad_fused_qkv(bqkv, width, padded_width)
+    pwo = _pad_dim(wo, 1, width, padded_width)
+    pw0 = _pad_dim(w0, 0, INTER, padded_inter)
+    pb0 = _pad_dim(b0, 0, INTER, padded_inter)
+    pw1 = _pad_dim(w1, 1, INTER, padded_inter)
+    assert pqkv.shape == (3 * padded_width, HIDDEN)
+    assert pbqkv.shape == (3 * padded_width,)
+    assert pwo.shape == (HIDDEN, padded_width)
+
+    heads_per_rank = padded_heads // TP
+    inter_per_rank = padded_inter // TP
+    attn_sum = torch.zeros(n, HIDDEN, dtype=dtype)
+    for rank in range(TP):
+        h0, h1 = (
+            rank * heads_per_rank * HEAD_DIM,
+            (rank + 1) * heads_per_rank * HEAD_DIM,
+        )
+        rows = torch.cat(
+            [
+                torch.arange(h0, h1),
+                padded_width + torch.arange(h0, h1),
+                2 * padded_width + torch.arange(h0, h1),
+            ]
+        )
+        qkv = x @ pqkv[rows].T + pbqkv[rows]
+        local = heads_per_rank * HEAD_DIM
+        q = qkv[:, :local].view(n, heads_per_rank, HEAD_DIM).transpose(0, 1)
+        k = qkv[:, local : 2 * local].view(n, heads_per_rank, HEAD_DIM).transpose(0, 1)
+        v = qkv[:, 2 * local :].view(n, heads_per_rank, HEAD_DIM).transpose(0, 1)
+        attn = torch.softmax((q @ k.transpose(1, 2)) * HEAD_DIM**-0.5, dim=-1) @ v
+        attn = attn.transpose(0, 1).reshape(n, local)
+        attn_sum += attn @ pwo[:, h0:h1].T
+    y = x + attn_sum + bo
+    mlp_sum = torch.zeros(n, HIDDEN, dtype=dtype)
+    for rank in range(TP):
+        c0, c1 = rank * inter_per_rank, (rank + 1) * inter_per_rank
+        h = torch.nn.functional.gelu(y @ pw0[c0:c1].T + pb0[c0:c1])
+        mlp_sum += h @ pw1[:, c0:c1].T
+    padded = y + mlp_sum + b1
+
+    torch.testing.assert_close(padded, reference, rtol=0, atol=1e-11)
+
+
+def test_pad_helpers_reject_mismatched_shapes():
+    with pytest.raises(ValueError, match="Expected vision tensor size"):
+        _pad_dim(torch.zeros(4, 3), 0, 5, 6)
+    with pytest.raises(ValueError, match="Expected fused QKV size"):
+        _pad_fused_qkv(torch.zeros(10, 3), 4, 6)
+    assert _pad_dim(torch.ones(4, 3), 1, 3, 3).shape == (4, 3)
