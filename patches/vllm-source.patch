+def test_glm_fp8_tp9_preserves_routed_shape_and_pads_dense_shared_mtp(
+    monkeypatch: pytest.MonkeyPatch,
+):
+    monkeypatch.setenv("VLLM_GLM_FP8_TP9", "1")
+    target = FakeOfficialGlmFp8ModelConfig()
+    vllm_config = _fake_vllm_config(
+        model_config=target, tensor_parallel_size=9, moe_backend="triton"
+    )
+    vllm_config.quant_config = None
+    vllm_config.speculative_config = SimpleNamespace(method="mtp")
+
+    maybe_apply_b12x_virtual_tp_padding(cast(Any, vllm_config))
