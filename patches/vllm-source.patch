+def test_glm_dcp9_fp32_combine_masks_empty_shards_and_writes_bf16(monkeypatch):
+    group = SimpleNamespace(world_size=9)
+    rows = 4
+    attn_out = torch.randn((rows, 72, 512), dtype=torch.float32)
+    lse = torch.randn((rows, 72), dtype=torch.float32)
+    calls = {}
+
+    class Pool:
+        def lse_reduce_scatter(self, partial, partial_lse, *, out, is_lse_base_on_e, channel_id):
+            calls["partial"] = partial
+            calls["lse"] = partial_lse.clone()
+            calls["base_e"] = is_lse_base_on_e
+            out.fill_(1.0)
+            return out
+
+    monkeypatch.setattr(mla_attention, "_glm_dcp9_b12x_pool", lambda *a, **kw: Pool())
+    monkeypatch.setattr(mla_attention, "_b12x_dcp_channel_id", lambda g: "eager:dcp")
+    # The second request has no KV on this rank: its rows get -inf LSE.
+    seq_lens = torch.tensor([5, 0], dtype=torch.int32)
+    query_start_loc = torch.tensor([0, 2, 4], dtype=torch.int32)
+    out = mla_attention._combine_glm_dcp9_b12x_fp32(
+        attn_out, lse, group, is_lse_base_on_e=True,
+        seq_lens=seq_lens, query_start_loc=query_start_loc,
