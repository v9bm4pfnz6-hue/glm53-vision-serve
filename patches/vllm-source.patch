+    config = target.hf_text_config
+    plan = getattr(config, VIRTUAL_TP_PLAN_ATTR)
+    assert plan["sharding"] == "glm-fp8-block-tp9"
+    assert config.num_attention_heads == 72
+    assert config.intermediate_size == 12672
+    assert config.moe_intermediate_size == 2048
+    assert plan["shared_expert_intermediate_size"]["padded_size"] == 2304
+    assert config.vocab_size == 154880
+    assert plan["vocab_size"]["padded_size"] == 154944
+    assert config.original_vocab_size == 154880
+
+    draft = FakeOfficialGlmFp8ModelConfig(draft=True)
+    SpeculativeConfig._maybe_apply_virtual_tp_to_draft(
+        cast(
+            Any,
+            SimpleNamespace(
+                method="mtp",
+                target_model_config=target,
+                draft_model_config=draft,
+                draft_parallel_config=ParallelConfig(tensor_parallel_size=9),
+            ),
