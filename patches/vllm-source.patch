+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""GLM-5.3-Vision composite checkpoint: configuration parity and processing.
+
+Runs against local checkpoints (no GPU): ``GLM5V_MODEL`` is the composite
+glm5v directory and ``GLM5V_TEXT_REFERENCE`` the standalone GLM-5.3 directory
+whose text shards the composite links to.
+"""
+
+import os
+
+import pytest
+from PIL import Image
+
+from vllm.config import ModelConfig
+from vllm.multimodal import MULTIMODAL_REGISTRY
+from vllm.multimodal.processing import InputProcessingContext
+from vllm.tokenizers import cached_tokenizer_from_config
+
+MODEL = os.environ.get("GLM5V_MODEL", "/model")
+TEXT_REFERENCE = os.environ.get("GLM5V_TEXT_REFERENCE", "/model-text-reference")
+IMAGE_TOKEN_ID = 154854
+BEGIN_IMAGE_ID, END_IMAGE_ID = 154830, 154831
+
+pytestmark = pytest.mark.skipif(
+    not (
+        os.path.isfile(f"{MODEL}/config.json")
+        and os.path.isfile(f"{TEXT_REFERENCE}/config.json")
+    ),
+    reason="composite and reference GLM-5.3 checkpoints are not mounted",
+)
+
+HF_OVERRIDES = {"use_index_cache": True, "index_topk_pattern": "F" * 78}
+
+
+def _model_config(path: str, **kwargs) -> ModelConfig:
+    # The composite nests the text model, so the indexer overrides must be
+    # addressed to text_config (vLLM applies nested dict overrides there).
+    overrides = (
+        HF_OVERRIDES if path == TEXT_REFERENCE else {"text_config": HF_OVERRIDES}
+    )
+    return ModelConfig(
+        path,
+        tokenizer=path,
+        dtype="bfloat16",
+        seed=0,
+        trust_remote_code=False,
+        max_model_len=8192,
+        hf_overrides=overrides,
+        **kwargs,
+    )
+
+
+def test_composite_text_config_matches_standalone_glm53():
+    composite = _model_config(MODEL, limit_mm_per_prompt={"vision_chunk": 1})
+    reference = _model_config(TEXT_REFERENCE)
+
+    assert type(composite.hf_config).__name__ == "Glm5vConfig"
+    assert reference.hf_text_config is reference.hf_config
+    assert composite.hf_text_config is composite.hf_config.text_config
+    assert composite.hf_text_config.model_type == "glm_moe_dsa"
+    assert composite.architectures == ["Glm5vForConditionalGeneration"]
+    assert composite.is_multimodal_model and not reference.is_multimodal_model
+
+    ignored = {"_name_or_path", "architectures", "transformers_version"}
