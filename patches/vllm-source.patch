+def _dump_capture_memory_summary(directory: str, local_rank: int) -> None:
+    """Write the live allocations after CUDA graph capture, grouped by call site.
+
+    Enabled by VLLM_CAPTURE_MEMORY_SNAPSHOT_DIR (rank 0). The summary attributes
+    the graph pool and every other live block to the innermost non-torch frame
+    of its allocation stack, so the memory a composition keeps resident after
+    capture can be read without a profiler.
+    """
+    import json
+
+    try:
+        snapshot = torch.cuda.memory._snapshot()
+    except Exception as error:  # noqa: BLE001 - diagnostics must never break capture
+        logger.warning("capture memory snapshot unavailable: %s", error)
+        return
+    by_site: dict[str, dict[str, int]] = {}
+    pool_total = 0
+    for segment in snapshot.get("segments", []):
+        is_pool = bool(segment.get("is_expandable")) is False and segment.get(
+            "segment_pool_id", (0, 0)
+        ) != (0, 0)
+        for block in segment.get("blocks", []):
+            if block.get("state") != "active_allocated":
+                continue
+            size = int(block.get("size", 0))
+            frames = block.get("frames") or []
+            site = "<no stack>"
+            for frame in frames:
+                filename = frame.get("filename", "")
+                if "/torch/" in filename or filename.endswith("_snapshot.py"):
+                    continue
+                site = f"{filename}:{frame.get('line')} {frame.get('name')}"
+                break
+            entry = by_site.setdefault(site, {"bytes": 0, "blocks": 0, "pool_bytes": 0})
+            entry["bytes"] += size
+            entry["blocks"] += 1
+            if is_pool:
+                entry["pool_bytes"] += size
+                pool_total += size
+    ranked = sorted(by_site.items(), key=lambda item: item[1]["bytes"], reverse=True)
+    summary = {
+        "rank": local_rank,
+        "pool_bytes_total": pool_total,
+        "live_bytes_total": sum(v["bytes"] for v in by_site.values()),
+        "sites": [{"site": site, **values} for site, values in ranked[:300]],
+    }
+    os.makedirs(directory, exist_ok=True)
+    path = os.path.join(directory, f"capture-memory-rank{local_rank}.json")
+    with open(path, "w") as handle:
+        json.dump(summary, handle, indent=1)
+    try:
+        torch.cuda.memory._dump_snapshot(
+            os.path.join(directory, f"capture-memory-rank{local_rank}.pickle")
+        )
+    except Exception as error:  # noqa: BLE001
+        logger.warning("capture memory pickle not written: %s", error)
+    logger.info(
+        "capture memory summary: %.2f GiB live, %.2f GiB in graph pools -> %s",
+        summary["live_bytes_total"] / (1 << 30),
+        pool_total / (1 << 30),
+        path,
+    )
+
