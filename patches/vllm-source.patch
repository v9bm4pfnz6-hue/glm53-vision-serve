+def test_chat_template_renders_image_parts_as_glm_placeholders():
+    """OpenAI image parts reach the template as unified vision chunks and are
+    rendered as <|begin_of_image|><|image|><|end_of_image|>; the rest of the
+    template is the served GLM-5.3 template."""
+    import io
