--- /dev/null
+++ b/tests/model_executor/layers/test_glm_dcp9_project.py
@@ -0,0 +1,282 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Projected FP32 DCP9 combine: weight assembly (CPU) and kernel numerics (GPU).
+
+The GPU tests compare the projection kernel against an FP64 reference and
+measure the served decode path (FP64 combine of 512-wide latents, BF16
+rounding, BF16 W_UV bmm) and the projected path (FP32 FMA projection with the
+checkpoint E4M3 weights, FP64 combine, one BF16 rounding) against the exact
+FP64 result; the projected path must not be less precise.
+"""
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.attention import glm_dcp9_project as proj
+
+WORLD = 9
+HEADS_PER_RANK = 8
+QK_NOPE = 192
+V_DIM = 256
+LATENT = 512
+HEAD_ROWS = QK_NOPE + V_DIM
+PADDED_HEADS = tuple(range(64, 72))
+
+
+def _fake_kv_b_shards(world: int, device, seed: int = 0):
+    gen = torch.Generator(device="cpu").manual_seed(seed)
+    rows = world * HEADS_PER_RANK * HEAD_ROWS
+    weight = torch.randn(rows, LATENT, generator=gen).clamp(-3, 3)
+    scale = torch.rand(rows // 128, LATENT // 128, generator=gen) * 0.02 + 0.005
+    # Padded heads 64..71 (rank 8) are all-zero rows as the TP9 port loads them.
+    weight.view(world * HEADS_PER_RANK, HEAD_ROWS, LATENT)[list(PADDED_HEADS)] = 0.0
+    fp8 = weight.to(torch.float8_e4m3fn)
+    return fp8.to(device), scale.to(device)
+
+
+def _shard(gathered_weight, gathered_scale, rank):
+    rows = HEADS_PER_RANK * HEAD_ROWS
+    blocks = rows // 128
+    return (
+        gathered_weight[rank * rows : (rank + 1) * rows].contiguous(),
+        gathered_scale[rank * blocks : (rank + 1) * blocks].contiguous(),
+    )
+
+
+@pytest.mark.parametrize("rank", [0, 3, 8])
+def test_projection_weights_cover_remote_real_heads_only(rank):
+    gathered_weight, gathered_scale = _fake_kv_b_shards(WORLD, "cpu")
+    local_weight, local_scale = _shard(gathered_weight, gathered_scale, rank)
+    weights = proj.build_glm_dcp9_projection_weights(
+        local_weight,
+        local_scale,
+        gathered_weight,
+        gathered_scale,
+        rank=rank,
+        qk_nope_head_dim=QK_NOPE,
+        v_head_dim=V_DIM,
+    )
+    assert weights.total_heads == 72
+    assert weights.heads_per_rank == HEADS_PER_RANK
+    assert weights.local_head_start == rank * HEADS_PER_RANK
+    assert weights.padded_heads == (PADDED_HEADS if rank != 8 else ())
+    local = set(range(rank * HEADS_PER_RANK, (rank + 1) * HEADS_PER_RANK))
+    expected_remote = [h for h in range(72) if h not in local and h not in PADDED_HEADS]
+    assert weights.table.shape == (len(expected_remote), V_DIM, LATENT)
+    assert weights.table_scale.shape == (len(expected_remote), V_DIM, LATENT // 128)
+    slots = weights.slots.tolist()
+    for head in range(72):
+        if head in local or head in PADDED_HEADS:
+            assert slots[head] == proj.PADDED_SLOT
+        else:
+            slot = slots[head]
+            assert expected_remote[slot] == head
+            rows = head * HEAD_ROWS + QK_NOPE + torch.arange(V_DIM)
+            assert torch.equal(
+                weights.table[slot].view(torch.uint8),
+                gathered_weight[rows].view(torch.uint8),
+            )
+            # Scale rows follow the 128-row blocks even where a head's value
+            # rows straddle a block boundary (448-row heads).
+            assert torch.equal(weights.table_scale[slot], gathered_scale[rows // 128])
+    # Exact per-head weights: local, remote and padded heads.
+    for head in (rank * HEADS_PER_RANK, (rank * HEADS_PER_RANK + 9) % 64, 70):
+        reference = proj.dequant_glm_dcp9_w_uv_reference(weights, head)
+        rows = head * HEAD_ROWS + QK_NOPE + torch.arange(V_DIM)
+        expected = (
+            gathered_weight[rows].double()
+            * gathered_scale[rows // 128].double().repeat_interleave(128, dim=1)
+        ).T
+        assert torch.equal(reference, expected)
+        if head in PADDED_HEADS:
+            assert not reference.any()
+
+
+def test_projection_weights_reject_bad_dtypes():
+    gathered_weight, gathered_scale = _fake_kv_b_shards(WORLD, "cpu")
+    local_weight, local_scale = _shard(gathered_weight, gathered_scale, 0)
+    with pytest.raises(TypeError):
+        proj.build_glm_dcp9_projection_weights(
+            local_weight.to(torch.bfloat16),
+            local_scale,
+            gathered_weight,
+            gathered_scale,
+            rank=0,
+            qk_nope_head_dim=QK_NOPE,
+            v_head_dim=V_DIM,
+        )
+    with pytest.raises(TypeError):
+        proj.build_glm_dcp9_projection_weights(
+            local_weight,
+            local_scale,
+            gathered_weight,
+            gathered_scale.to(torch.bfloat16),
+            rank=0,
+            qk_nope_head_dim=QK_NOPE,
+            v_head_dim=V_DIM,
+        )
+
+
+def _exact_w_uv(gathered_weight, gathered_scale, head):
+    rows = (
+        head * HEAD_ROWS + QK_NOPE + torch.arange(V_DIM, device=gathered_weight.device)
+    )
+    return (
+        gathered_weight[rows].double()
+        * gathered_scale[rows // 128].double().repeat_interleave(128, dim=1)
+    ).T  # [latent, v]
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a GPU")
+@pytest.mark.parametrize("rank", [0, 8])
+@pytest.mark.parametrize("rows", [1, 4, 16, 33])
+def test_projection_kernel_matches_fp64_reference(rank, rows):
+    device = torch.device("cuda")
+    gathered_weight, gathered_scale = _fake_kv_b_shards(WORLD, device)
+    local_weight, local_scale = _shard(gathered_weight, gathered_scale, rank)
+    weights = proj.build_glm_dcp9_projection_weights(
+        local_weight,
+        local_scale,
+        gathered_weight,
+        gathered_scale,
+        rank=rank,
+        qk_nope_head_dim=QK_NOPE,
+        v_head_dim=V_DIM,
+    )
+    gen = torch.Generator(device="cpu").manual_seed(11 + rows)
+    # Head-major capacity-strided layout as the sparse MLA kernel produces.
+    storage = torch.randn(72, 40, LATENT, generator=gen).to(device)
+    partial = storage[:, :rows, :].transpose(0, 1)
+    assert partial.stride(2) == 1 and partial.shape == (rows, 72, LATENT)
+    out = proj.glm_dcp9_project_partials(partial, weights)
+    assert out.shape == (rows, 72, V_DIM) and out.dtype == torch.float32
+    worst = 0.0
+    for head in range(72):
+        exact = partial[:, head, :].double() @ _exact_w_uv(
+            gathered_weight, gathered_scale, head
+        )
+        if head in PADDED_HEADS:
+            assert not out[:, head, :].any()
+            continue
+        err = (out[:, head, :].double() - exact).abs().max().item()
+        scale = exact.abs().max().item()
+        worst = max(worst, err / scale)
+    # FP32 FMA accumulation over 512 terms: errors stay at the 1e-6 level.
+    assert worst < 4e-6, worst
+    contiguous = proj.glm_dcp9_project_partials(partial.contiguous(), weights)
+    assert torch.equal(contiguous, out)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs a GPU")
+def test_projected_combine_is_not_less_precise_than_served_path():
+    device = torch.device("cuda")
+    gathered_weight, gathered_scale = _fake_kv_b_shards(WORLD, device, seed=5)
+    gen = torch.Generator(device="cpu").manual_seed(23)
+    rows = 4
+    partials = torch.randn(WORLD, rows, 72, LATENT, generator=gen).to(device)
+    lse = (torch.randn(WORLD, rows, 72, generator=gen) * 2.0 + 5.0).to(device).double()
+    weights = torch.softmax(lse, dim=0)  # [world, rows, heads] exact combine weights
+    served_errors, projected_errors = [], []
+    for dest in range(8):  # destination ranks owning real heads
+        heads = list(range(dest * HEADS_PER_RANK, (dest + 1) * HEADS_PER_RANK))
+        w_exact = torch.stack(
+            [_exact_w_uv(gathered_weight, gathered_scale, h) for h in heads]
+        )  # [8, latent, v]
+        # Exact: FP64 everything.
+        latent_exact = torch.einsum(
+            "wrh,wrhl->hrl", weights[:, :, heads], partials[:, :, heads, :].double()
+        )  # [8, rows, latent]
+        exact = torch.bmm(latent_exact, w_exact)  # [8, rows, v]
+        # Served path: FP32 weights, FP64 accumulate, BF16 latent, BF16 W_UV bmm.
+        weights32 = weights.float()[:, :, heads].double()
+        latent_served = torch.einsum(
+            "wrh,wrhl->hrl", weights32, partials[:, :, heads, :].double()
+        ).to(torch.bfloat16)
+        rows_idx = (
+            torch.tensor(heads, device=device)[:, None] * HEAD_ROWS
+            + QK_NOPE
+            + torch.arange(V_DIM, device=device)[None, :]
+        )
+        w_uv_bf16 = (
+            (
+                gathered_weight[rows_idx].float()
+                * gathered_scale[rows_idx // 128].float().repeat_interleave(128, dim=2)
+            )
+            .to(torch.bfloat16)
+            .transpose(1, 2)
+            .contiguous()
+        )  # [8, latent, v] as the served W_UV
+        served = torch.bmm(latent_served, w_uv_bf16)  # BF16 out, FP32 accumulate
+        # Projected path: per-rank FP32 projection kernel, FP64 weighted sum,
+        # one BF16 rounding.
+        projected = torch.zeros(
+            HEADS_PER_RANK, rows, V_DIM, dtype=torch.float64, device=device
+        )
+        for src in range(WORLD):
+            local_weight, local_scale = _shard(gathered_weight, gathered_scale, src)
+            src_weights = proj.build_glm_dcp9_projection_weights(
+                local_weight,
+                local_scale,
+                gathered_weight,
+                gathered_scale,
+                rank=src,
+                qk_nope_head_dim=QK_NOPE,
+                v_head_dim=V_DIM,
+            )
+            v_src = proj.glm_dcp9_project_partials(
+                partials[src].contiguous(), src_weights
+            )
+            projected += (
+                weights32[src].T.unsqueeze(-1)
+                * v_src[:, heads, :].transpose(0, 1).double()
+            )
+        projected = projected.to(torch.bfloat16)
+        served_errors.append((served.double() - exact).pow(2).mean().sqrt().item())
+        projected_errors.append(
+            (projected.double() - exact).pow(2).mean().sqrt().item()
+        )
+    served_rms = sum(served_errors) / len(served_errors)
+    projected_rms = sum(projected_errors) / len(projected_errors)
+    print(f"rms error vs exact: served {served_rms:.3e} projected {projected_rms:.3e}")
+    assert projected_rms <= served_rms
+
+
+def test_projection_tables_share_one_arena_per_device():
+    proj._ARENAS.clear()
+    gathered_weight, gathered_scale = _fake_kv_b_shards(WORLD, "cpu", seed=3)
+    local_weight, local_scale = _shard(gathered_weight, gathered_scale, 2)
+    first, second = (
+        proj.build_glm_dcp9_projection_weights(
+            local_weight,
+            local_scale,
+            gathered_weight,
+            gathered_scale,
+            rank=2,
+            qk_nope_head_dim=QK_NOPE,
+            v_head_dim=V_DIM,
+            layers_hint=2,
+        )
+        for _ in range(2)
+    )
+    assert first.table.data_ptr() + first.table.numel() == second.table.data_ptr()
+    assert first.table_scale.untyped_storage().data_ptr() == (
+        second.table_scale.untyped_storage().data_ptr()
+    )
+    assert torch.equal(first.table, second.table)
+    # A third layer exceeds the hint and opens a one-layer chunk.
+    third = proj.build_glm_dcp9_projection_weights(
+        local_weight,
+        local_scale,
+        gathered_weight,
+        gathered_scale,
+        rank=2,
+        qk_nope_head_dim=QK_NOPE,
+        v_head_dim=V_DIM,
+        layers_hint=2,
+    )
+    assert (
+        third.table.untyped_storage().data_ptr()
+        != first.table.untyped_storage().data_ptr()
+    )
+    assert torch.equal(third.table, first.table)
+    proj._ARENAS.clear()
