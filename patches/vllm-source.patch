+    gathers = []
+
+    class FakePool:
+        def all_gather_heads(self, local_input, *, out, channel_id):
+            assert local_input.dtype == torch.bfloat16
+            assert tuple(local_input.shape) == (rows, 1, 4 * topk)
+            assert tuple(out.shape) == (rows, world_size, 4 * topk)
